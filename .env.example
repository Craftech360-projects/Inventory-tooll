# Template for local development. Copy to .env and fill in real values.
#   cp .env.example .env
#
# Read by netlify/functions/supabase-client.js (via local-server.js locally,
# via api/*.js on Vercel). The same two values must be set in
# Vercel -> Project Settings -> Environment Variables.

# Supabase project URL. Format: https://<project-ref>.supabase.co
SUPABASE_URL=https://your-project-ref.supabase.co

# anon / public key.
# Note: this only works if Row Level Security is disabled on the tables, or has
# policies allowing anon read+write. With RLS on and no policies, reads return
# empty results with no error and writes fail.
SUPABASE_ANON_KEY=your-anon-key

# Takes priority over SUPABASE_ANON_KEY if set. Bypasses RLS entirely.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional. Local server port, defaults to 3000.
# PORT=3000
