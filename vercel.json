{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    { "source": "/netlify/:path*", "destination": "/", "permanent": false },
    { "source": "/lib/:path*", "destination": "/", "permanent": false }
  ],
  "rewrites": [
    { "source": "/.netlify/functions/:fn", "destination": "/api/:fn" }
  ],
  "headers": [
    {
      "source": "/api/:fn",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    }
  ]
}
